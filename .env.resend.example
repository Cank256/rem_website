# ============================================
# RESEND EMAIL CONFIGURATION
# ============================================
# 
# This file shows the required environment variables
# for Resend.com email integration.
#
# SETUP INSTRUCTIONS:
# 1. Sign up at https://resend.com
# 2. Get your API key from the dashboard
# 3. Copy these values to your .env file
# 4. Replace the placeholder values with your actual values
# 5. Run: php artisan config:clear
# 6. Test: php artisan resend:test your-email@example.com
#
# ============================================

# Mail Driver - Use 'resend' for Resend.com
MAIL_MAILER=resend

# From Address - Must use your verified domain in production
# For testing, you can use any email address
MAIL_FROM_ADDRESS="noreply@yourdomain.com"

# From Name - Your church or organization name
MAIL_FROM_NAME="Rural Evangelical Ministries"

# Resend API Key - Get this from https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_your_api_key_here

# ============================================
# OPTIONAL: Queue Configuration
# ============================================
# For better performance, use database queue
# Uncomment and run: php artisan queue:work
#
# QUEUE_CONNECTION=database

# ============================================
# PRODUCTION NOTES:
# ============================================
# 1. Verify your domain in Resend dashboard
# 2. Use your verified domain in MAIL_FROM_ADDRESS
# 3. Use a production API key (not test key)
# 4. Set up SPF, DKIM, DMARC records
# 5. Enable queue for better performance
#
# Example production config:
# MAIL_FROM_ADDRESS="noreply@ruralevangelicalministries.org"
# RESEND_API_KEY=re_production_key_here
# QUEUE_CONNECTION=database

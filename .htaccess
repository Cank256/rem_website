# =============================================================================
# Church Website — root .htaccess
# Blocks direct web access to everything outside the public/ directory.
# This is a safety net for hosts that point the document root at the
# project root instead of public/. Ideally, fix the document root instead.
# =============================================================================

# Enable PHP extensions (cPanel shared hosting)
<IfModule mod_php.c>
    php_flag extension intl On
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny access to sensitive Laravel directories and files
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Deny access to dot-files (.env, .git, .gitignore, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Deny access to composer and npm files
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|artisan|setup\.sh)$ - [F,L]

    # Redirect everything else into public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block direct access regardless of mod_rewrite
<FilesMatch "\.(env|log|sh|sql|sqlite|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
